# HA internals
.storage/
.cloud/
backups/
deps/
tts/
archive/
image/
f1_replay_cache/
glances/
gtfs2/
espresense/
everything-presence-zone-configurator/

# HACS - reinstall, don't track
custom_components/
www/*
!www/floorplan

# Node-RED - has its own backup
node-red/

# ESPHome - track device configs, secrets.yaml excluded via secrets.yaml rule above
esphome/archive/

# Zigbee2MQTT - logs only, keep config
zigbee2mqtt/log/

# HA runtime files
*.log
*.log.1
*.log.fault
*.db
*.db-shm
*.db-wal
secrets.yaml

# Arduino secrets
arduino/alarm_panel/secrets.h

# OS junk
.DS_Store
Thumbs.db
__pycache__/
*.pyc

# Runtime/lock files
.ha_run.lock
.shopping_list.json
home-assistant.log.old
watchman_report.txt

# Binaries
go2rtc-1.9.9

# Dev scripts (keep in cinematic-dashboard repo instead)
*.ps1
*.py
.cache/
.aider*

# Local safety backups from manual/agent edits
*.bak
*.bak-*
*.bak-*/

# Newline-mangling corruption pattern (known SSH-command-wrapper bug) - never real config
*.yamln*

# Backup/scratch copies - not config
*.bak
*.bak.*
*.bak_*
*-bak-*

# Debug/troubleshooting output dumps
.check_config_out*.txt
*_output*.txt

# SSH keys referenced by shell_command scripts - must stay in /config for
# HA container to see them, but must never be staged/committed
.ssh/
